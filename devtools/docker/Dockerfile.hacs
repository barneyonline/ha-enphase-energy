# HACS validator source: hacs/integration@279f8f18a615ef046c452211c2e474d3cb12c1ca.
# The upstream action wraps a floating image; pin its last pre-2026.10 image.
FROM --platform=linux/amd64 ghcr.io/hacs/action@sha256:a0336b447da4500204122cabea01cac1e0992840d8b927535782ddd5b601f698 AS hacs-validator

# Copy validator files only; retain the immutable HA 2026.9.0 runtime/dependencies.
FROM ghcr.io/home-assistant/home-assistant@sha256:372d991e58882a1d8c68c07e9aa3f3b509276e695355f73ccdb03baa70407293
COPY --from=hacs-validator /hacs /hacs
WORKDIR /hacs
RUN python3 -c "from homeassistant.const import __version__; assert __version__ == '2026.9.0', __version__; print(f'Home Assistant {__version__}')"
ENTRYPOINT ["python3", "/hacs/action.py"]
